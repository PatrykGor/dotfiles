*** ~posframe~

Making ~vertico~ use ~posframe~ makes ~EXWM~ look like a real window manager. I love this package, even though
it needs fixes to work with ~EXWM~, ironically. I modify the default refposhandler to account for the outer gaps. Not the most elegant solution
but it works.

#+begin_src elisp :tangle yes
  (use-package vertico-posframe
    :ensure t
    :ensure-system-package (xwininfo . xorg-xwininfo)
    :after vertico
    :custom
    (vertico-posframe-poshandler #'posframe-poshandler-frame-top-center)
    (vertico-posframe-parameters
          '((internal-border-width . 0)
            (left-fringe . 8)
            (right-fringe . 8)))
    :init
    (defun vertico-posframe-refposhandler-status (&optional frame)
        "Parent FRAME poshander function.
    Get the position of parent frame (current frame) with the help of
    xwininfo."
        (when (executable-find "xwininfo")
          (with-temp-buffer
            (let ((case-fold-search nil))
              (call-process "xwininfo" nil t nil
                            "-display" (frame-parameter frame 'display)
                            "-id"  (frame-parameter frame 'window-id))
              (goto-char (point-min))
              (search-forward "Absolute upper-left")
              (let ((x (string-to-number
                        (buffer-substring-no-properties
                         (search-forward "X: ")
                         (line-end-position))))
                    (y (- (string-to-number
                           (buffer-substring-no-properties
                            (search-forward "Y: ")
                            (line-end-position))) (aref exwm-outer-gaps-width 2))))
                (cons x y))))))
      (setq vertico-posframe-refposhandler #'vertico-posframe-refposhandler-status)
      :config
      (vertico-posframe-mode 1))
#+end_src

