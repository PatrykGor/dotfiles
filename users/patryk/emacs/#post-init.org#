** Styling

I use the ~org-modern~ package to make viewing ~org~ buffers much more pleasant. I combine it with parts of [[https://zzamboni.org/post/beautifying-org-mode-in-emacs/][Diego Zamboni's]] Org mode configuration. And the ~org-moder-indent~ package, which allows it to work
with ~org-indent-mode~.

#+begin_src elisp :tangle yes
  (use-package org-modern
    :ensure t
    :custom
    (org-modern-hide-stars nil)		; adds extra indentation
    (org-modern-table nil)
    (org-modern-list 
     '((?- . "-")
       (?* . "•")
       (?+ . "‣")))
    (org-modern-block-name '("" . "")) ; or other chars; so top bracket is drawn promptly
    :hook
    (org-mode . org-modern-mode)
    (org-agenda-finalize . org-modern-agenda)
    :init
    (setq
     ;; Edit settings
     org-auto-align-tags nil
     org-tags-column 0
     org-catch-invisible-edits 'show-and-error
     org-special-ctrl-a/e t
     org-insert-heading-respect-content t
     org-startup-with-latex-preview t
     org-startup-with-inline-images t
